#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                      &kp W   &kp E     &kp R             &kp T                                                             &kp Y            &kp U  &lt 5 I    &kp O    &kp P
&kp A                      &kp S   &kp D     &kp F             &kp G        &kp DELETE                         &mt CAPS SQT      &kp H            &kp J  &kp K      &kp L    &mt RIGHT_SHIFT ENTER
&lt 4 Z                    &kp X   &kp C     &kp V             &kp B        &kp SINGLE_QUOTE                   &kp SEMICOLON     &kp N            &kp M  &kp COMMA  &kp DOT  &kp SLASH
&mt LANGUAGE_1 LANGUAGE_2  &trans  &kp LWIN  &kp INT_MUHENKAN  &lt 2 SPACE  &lt_to_layer_0 3 INT_MUHENKAN      &kp LEFT_CONTROL  &lt 1 BACKSPACE                             &mo 6
            >;
        };

        FUNCTION {
            bindings = <
&kp ESCAPE      &kp F1  &kp F2   &kp F3        &kp F4                                                        &kp LEFT_PARENTHESIS  &kp HOME  &kp UP_ARROW    &kp END    &kp RIGHT_PARENTHESIS
&kp TAB         &kp F5  &kp F6   &kp F7        &kp F8        &kp C_VOLUME_UP               &kp LESS_THAN     &kp LEFT_BRACE        &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp RIGHT_BRACE
&kp LEFT_SHIFT  &kp F9  &kp F10  &kp F11       &kp F12       &mt K_MUTE C_VOLUME_DOWN      &kp GREATER_THAN  &kp LEFT_BRACKET      &trans    &trans          &trans     &kp RIGHT_BRACKET
&trans          &trans  &trans   &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL              &trans            &trans                                                     &trans
            >;
        };

        NUM {
            bindings = <
&kp UNDERSCORE   &kp EXCLAMATION  &kp AT_SIGN           &kt HASH       &kp PIPE                                 &kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&kp CARET        &kt PERCENT      &kp NON_US_BACKSLASH  &kp AMPERSAND  &kp EQUAL  &kp DOLLAR      &kp PLUS      &kp MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp N0
&kp RIGHT_SHIFT  &trans           &trans                &trans         &trans     &trans          &kt ASTERISK  &kp SLASH  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans
&trans           &trans           &trans                &trans         &trans     &trans          &trans        &kp COMMA                                            &trans
            >;
        };

        move {
            bindings = <
&trans  &trans  &trans    &trans  &trans                         &trans  &kp LG(LS(LEFT))  &kp LG(UP_ARROW)    &kp LS(LG(RIGHT))  &trans
&trans  &trans  &kp LEFT  &trans  &kp RIGHT  &trans      &trans  &trans  &kp LG(LEFT)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT)      &trans
&trans  &trans  &trans    &trans  &trans     &trans      &trans  &trans  &trans            &trans              &trans             &trans
&trans  &trans  &trans    &trans  &trans     &trans      &trans  &trans                                                           &trans
            >;
        };

        MOUSE {
            bindings = <
&trans          &trans  &kp LC(PAGE_UP)    &kp RC(W)  &trans                      &trans              &trans    &trans    &trans    &trans
&kp LEFT_SHIFT  &trans  &kp LC(PAGE_DOWN)  &kp LC(T)  &trans  &trans      &trans  &kp RA(LEFT_ARROW)  &mkp MB1  &mkp MB3  &mkp MB2  &kp RA(RIGHT_ARROW)
&trans          &trans  &trans             &trans     &trans  &trans      &trans  &trans              &trans    &trans    &trans    &trans
&kp LS(LG(S))   &trans  &trans             &trans     &trans  &trans      &trans  &kp LC(R)                                         &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp LEFT_CONTROL      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
